      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is WhatsApp Business API?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The WhatsApp Business API is Meta's official solution for medium and large businesses to communicate with customers at scale. It allows multiple users to manage conversations, automate responses and integrate WhatsApp with other business systems."
          }
        },
        {
          "@type": "Question",
          "name": "How is WhatsApp Business API different from WhatsApp Business App?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The WhatsApp Business App is designed for small businesses with a single user, while the API supports multiple users, automation, CRM integration and advanced messaging features for growing companies."
          }
        },
        {
          "@type": "Question",
          "name": "Is WhatsApp Business API expensive?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pricing includes Meta's messaging charges, platform subscription fees and optional services like chatbot development. We provide customised quotations based on your message volume and requirements."
          }
        },
        {
          "@type": "Question",
          "name": "Can I keep my existing phone number?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, you can keep your existing WhatsApp Business phone number during the API setup process. The number will be verified and connected to the API."
          }
        },
        {
          "@type": "Question",
          "name": "How long does the integration take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most integrations are completed within 2-4 weeks, depending on the complexity of your requirements, existing systems and customisation needs."
          }
        },
        {
          "@type": "Question",
          "name": "What kind of businesses can use WhatsApp Business API?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Any business that communicates with customers via WhatsApp can use the API. It's suitable for ecommerce, real estate, healthcare, education, hospitality and professional services."
          }
        }
      ]
